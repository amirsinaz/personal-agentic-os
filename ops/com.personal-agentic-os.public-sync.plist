<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personal-agentic-os.public-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__REPO_ROOT__/scripts/watch-public-changes.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>WatchPaths</key>
  <array>
    <string>__PRIVATE_TEMPLATES_PATH__</string>
    <string>__PRIVATE_DASHBOARD_PATH__</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/personal-agentic-os-public-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/personal-agentic-os-public-sync-error.log</string>
</dict>
</plist>
